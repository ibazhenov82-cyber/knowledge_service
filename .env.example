# --- Сервер ---------------------------------------------------------------
KNOWLEDGE_HOST=0.0.0.0
KNOWLEDGE_PORT=8003
# Каталог данных: knowledge.sqlite и копии загруженных файлов/страниц.
KNOWLEDGE_DATA_DIR=knowledge_data
# Ключ API (заготовка): если задан — запросы должны нести Authorization: Bearer <ключ>.
KNOWLEDGE_API_KEY=
KNOWLEDGE_LOG_LEVEL=INFO

# --- Эмбеддинги -----------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Модель по умолчанию для новых баз знаний: «провайдер/модель».
KB_DEFAULT_EMBEDDING_MODEL=ollama/qwen3-embedding:0.6b
# OpenAI-совместимые провайдеры (см. embedding_providers.example.json).
EMBEDDING_PROVIDERS_FILE=
KB_EMBED_BATCH=32
KB_EMBED_TIMEOUT=120

# --- Реранкинг (второй этап поиска) ----------------------------------------
# «Эвристика (без LLM)» доступна всегда. Модели-реранкеры (cross-encoder,
# API /rerank: llama.cpp server --reranking, Infinity, TEI, Jina, Cohere) —
# в файле (см. rerank_providers.example.json); их список видит приложение.
RERANK_PROVIDERS_FILE=
# Реранкер по умолчанию «провайдер/модель»; пусто — первый из файла.
KB_DEFAULT_RERANK_MODEL=
# Сколько ждать модель-реранкер (с); не дождались — эвристика с пометкой
# «эвристика вместо модели». Держите меньше KNOWLEDGE_SERVICE_TIMEOUT в AgentsCore
# (по умолчанию 60): иначе AgentsCore оборвёт поиск раньше отката.
KB_RERANK_TIMEOUT=20
# Сколько символов фрагмента отдавать реранкеру (начало с заголовком); 0 — весь.
# На CPU время реранкинга растёт с длиной текста и числом кандидатов.
KB_RERANK_MAX_CHARS=1500

# --- Источники ------------------------------------------------------------
# Разрешённые корни для источников «путь / папка / glob» (через запятую).
# Пусто — такие источники выключены.
KB_ROOTS=/data
# Внутренние хосты, которые можно загружать по ссылке (например, Confluence в
# локальной сети). Остальные ссылки — только на публичные адреса.
KB_ALLOWED_HOSTS=
# Секреты для заголовков авторизации: ИМЯ@хост1|хост2 (через запятую).
# Значение — переменная окружения с тем же именем; отправляется только на эти хосты.
KB_SECRETS=
# CONFLUENCE_TOKEN=...
KB_MAX_FILE_MB=50
KB_MAX_SOURCE_DOCUMENTS=5000
KB_CRAWL_MAX_PAGES=200
KB_CRAWL_MAX_DEPTH=3
KB_HTTP_TIMEOUT=30

# --- Выполнение -----------------------------------------------------------
# Сколько задач загрузки выполняется одновременно.
KB_WORKERS=1
